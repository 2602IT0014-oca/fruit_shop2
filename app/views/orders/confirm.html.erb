<h1>注文確認</h1>

<h3>注文商品一覧</h3>

<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>個数</th>
      <th>価格</th>
      <th>小計</th>
    </tr>
  </thead>

  <tbody>
    <% @cart_items.each do |cart_item| %>
      <tr>
        <td>
          <%= cart_item.product.name %>
        </td>

        <td>
          <%= cart_item.quantity %>
        </td>

        <td>
          ¥<%= number_with_delimiter(cart_item.product.price) %>
        </td>

        <td>
          ¥<%= number_with_delimiter(
            cart_item.product.price * cart_item.quantity
          ) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h3>合計金額</h3>

<p>
  ¥<%= number_with_delimiter(@total_price) %>
</p>

<h3>お届け先</h3>

<p>
  <%= @order.address %>
</p>

<%= form_with(
  model: @order,
  url: orders_path,
  method: :post,
  local: true,
  data: { turbo: false }
) do |form| %>

  <%= form.hidden_field :address %>

  <div class="actions">
    <%= form.submit "注文確定" %>
  </div>

<% end %>

<div style="margin-top: 15px;">
  <%= link_to "注文画面に戻る", new_order_path %>
</div>
